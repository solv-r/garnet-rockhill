# Copy this file to .env.local and fill the three keys from:  npx supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY

CORPORATE_URL=http://localhost:3000
HOMES_URL=http://homes.localhost:3000

# Leave email unset locally: enquiries are still saved and shown as "Email not configured".
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=

CONTACT_PHONE=+2349036666987
CONTACT_EMAIL=garnetrockhill@gmail.com
CONTACT_WHATSAPP=2349036666987
CONTACT_ADDRESS=Suite 60/63 Block C, New Extension, EFAB Mall, Area 11, Abuja, FCT, Nigeria

# Map: free OpenFreeMap tiles are used by default. No key needed.
MAP_STYLE_URL=                       # optional; default is the free OpenFreeMap "liberty" style (no key)

# Form delivery via Formspree. Replace YOUR_... with real form IDs from formspree.io (the part after /f/). Placeholders are ignored.
FORMSPREE_FORM_ID_CORPORATE=YOUR_FORMSPREE_ID_CORPORATE
FORMSPREE_FORM_ID_HOMES=YOUR_FORMSPREE_ID_HOMES
# Set to true ONLY after a Nigerian lawyer has reviewed the legal pages (hides the "draft" notice).
LEGAL_REVIEWED=false
