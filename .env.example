# Public (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=            # Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # same page, "anon public" key
CORPORATE_URL=http://localhost:3000  # becomes https://garnetrockhill.com
HOMES_URL=http://homes.localhost:3000 # becomes https://homes.garnetrockhill.com
# Server only: NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=           # same page, "service_role" key
RESEND_API_KEY=                      # resend.com > API Keys (optional until email is set up)
NOTIFY_FROM=                         # verified sender, e.g. enquiries@garnetrockhill.com
NOTIFY_TO=                           # team inbox that receives enquiries
# Contact details (shared by both brands for now; confirm before launch)
CONTACT_PHONE=+2349036666987
CONTACT_EMAIL=garnetrockhill@gmail.com
CONTACT_WHATSAPP=2349036666987       # digits only, international format, no +
CONTACT_ADDRESS=Suite 60/63 Block C, New Extension, EFAB Mall, Area 11, Abuja, FCT, Nigeria
MAP_STYLE_URL=                       # optional; default is the free OpenFreeMap "liberty" style (no key)

# Form delivery via Formspree. Replace YOUR_... with real form IDs from formspree.io (the part after /f/). Placeholders are ignored.
FORMSPREE_FORM_ID_CORPORATE=YOUR_FORMSPREE_ID_CORPORATE
FORMSPREE_FORM_ID_HOMES=YOUR_FORMSPREE_ID_HOMES
# Set to true ONLY after a Nigerian lawyer has reviewed the legal pages (hides the "draft" notice).
LEGAL_REVIEWED=false
